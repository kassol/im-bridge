# Copy to .env and fill in. Never commit the real file.

# From @BotFather. Threaded mode must be enabled for the bot
# (BotFather Mini App -> the bot -> Threaded mode), otherwise
# createForumTopic fails with "the chat is not a forum".
TG_BOT_TOKEN=

# Comma-separated numeric Telegram user ids. This is the only
# authentication in front of an agent that can run shell commands.
# Empty means the bridge refuses to start.
TG_ALLOWED_USER_IDS=

# dsh web listener. Start it with skill injection disabled:
#   DSH_AGENTS_HOME=~/.dsh/empty-agents dsh web --no-open --port 3080
DSH_URL=http://127.0.0.1:3080

IM_BRIDGE_DB=./im-bridge.db
